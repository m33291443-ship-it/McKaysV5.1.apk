  const [showPass, setShowPass] = useState(false);

  const handleLogin = (e) => {
    e.preventDefault();
    if (username === 'mckays' && password === 'bismillah22') {
      setCurrentUser({ username: 'mckays', role: 'admin', branch: 'Pusat' });
      showToast('Login berhasil sebagai Admin Pusat!');
      return;
    }

    const foundStaff = staffAccounts.find(s => s.username === username && s.password === password);
    if (foundStaff) {
      setCurrentUser({ username: foundStaff.username, role: 'staff', branch: foundStaff.branch });
      showToast(`Login berhasil sebagai Staff (${foundStaff.branch})!`);
      return;
    }

    alert('ID atau Password salah!');
