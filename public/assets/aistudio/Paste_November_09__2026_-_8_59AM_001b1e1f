// 4. HISTORY TAB
// ============================================================================
function HistoryTab({ currentUser, transactions, darkMode, showToast }) {
  const isAdmin = currentUser.role === 'admin';
  const activeBranch = currentUser.branch;

  const [filterType, setFilterType] = useState('daily');
  const [selectedDate, setSelectedDate] = useState(new Date().toISOString().split('T')[0]);
  const [selectedMonth, setSelectedMonth] = useState(new Date().toISOString().slice(0, 7));
  const [selectedYear, setSelectedYear] = useState(new Date().getFullYear().toString());

  const filteredTx = transactions.filter(tx => {
    if (!isAdmin && tx.branch !== activeBranch) return false;

    if (filterType === 'daily') return tx.date === selectedDate;
    if (filterType === 'monthly') return tx.date.startsWith(selectedMonth);
    if (filterType === 'yearly') return tx.date.startsWith(selectedYear);
    return true;
  });

  const totalOmzetFiltered = filteredTx.reduce((sum, tx) => sum + tx.price, 0);

  const exportCSV = () => {
    let csvContent = "data:text/csv;charset=utf-8,No,Tanggal,ID Transaksi,Cabang,Tipe,Produk,Harga,Member\n";
    filteredTx.forEach((tx, idx) => {
      csvContent += `${idx + 1},${tx.date},${tx.id},${tx.branch},${tx.type},"${tx.item}",${tx.price},"${tx.member}"\n`;
    });
    const encodedUri = encodeURI(csvContent);
    const link = document.createElement("a");
    link.setAttribute("href", encodedUri);
    link.setAttribute("download", `Laporan_Omset_${filterType}_${new Date().toISOString().split('T')[0]}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    showToast('Laporan CSV berhasil diunduh!');
  };

  const exportPDF = () => {
    window.print();
    showToast('Membuka dialog cetak PDF...');
  };

  return (
    <div className="p-4 max-w-md mx-auto space-y-4">
      <div>
        <h2 className="text-lg font-black">Riwayat Transaksi</h2>
        <p className="text-xs text-slate-400">Filter berdasarkan Kalender Masehi</p>
      </div>

      <div className={`p-4 rounded-3xl border space-y-3 ${darkMode ? 'bg-gray-900 border-gray-800' : 'bg-white border-slate-200 shadow-sm'}`}>
        <div className="flex gap-2">
          <button onClick={() => setFilterType('daily')} className={`flex-1 py-2 rounded-xl text-xs font-bold ${filterType === 'daily' ? 'bg-blue-600 text-white' : 'bg-slate-100 dark:bg-gray-800 text-slate-400'}`}>Harian</button>
          <button onClick={() => setFilterType('monthly')} className={`flex-1 py-2 rounded-xl text-xs font-bold ${filterType === 'monthly' ? 'bg-blue-600 text-white' : 'bg-slate-100 dark:bg-gray-800 text-slate-400'}`}>Bulanan</button>
          <button onClick={() => setFilterType('yearly')} className={`flex-1 py-2 rounded-xl text-xs font-bold ${filterType === 'yearly' ? 'bg-blue-600 text-white' : 'bg-slate-100 dark:bg-gray-800 text-slate-400'}`}>Tahunan</button>
        </div>

        {filterType === 'daily' && (
          <input type="date" value={selectedDate} onChange={(e) => setSelectedDate(e.target.value)} className="w-full px-4 py-2.5 rounded-2xl border dark:border-gray-700 bg-slate-50 dark:bg-gray-800 text-xs font-bold" />
        )}
        {filterType === 'monthly' && (
          <input type="month" value={selectedMonth} onChange={(e) => setSelectedMonth(e.target.value)} className="w-full px-4 py-2.5 rounded-2xl border dark:border-gray-700 bg-slate-50 dark:bg-gray-800 text-xs font-bold" />
        )}
        {filterType === 'yearly' && (
          <input type="number" value={selectedYear} onChange={(e) => setSelectedYear(e.target.value)} className="w-full px-4 py-2.5 rounded-2xl border dark:border-gray-700 bg-slate-50 dark:bg-gray-800 text-xs font-bold" />
        )}

        <div className="pt-2 flex justify-between items-center text-xs font-bold">
          <span className="text-slate-400">Total Omset:</span>
          <span className="text-blue-500 font-black text-sm">Rp {totalOmzetFiltered.toLocaleString('id-ID')}</span>
        </div>

        <div className="grid grid-cols-2 gap-2 pt-2">
          <button onClick={exportCSV} className="py-2.5 rounded-xl bg-emerald-600 text-white text-xs font-bold flex items-center justify-center gap-1.5 shadow-md">
            <Download className="w-3.5 h-3.5" /> CSV
          </button>
          <button onClick={exportPDF} className="py-2.5 rounded-xl bg-blue-600 text-white text-xs font-bold flex items-center justify-center gap-1.5 shadow-md">
            <FileText className="w-3.5 h-3.5" /> PDF
          </button>
        </div>
      </div>

      <div className="space-y-2">
        {filteredTx.length === 0 ? (
          <p className="text-center py-12 text-slate-400 text-xs">Tidak ada riwayat transaksi.</p>
        ) : (
          filteredTx.map((tx) => (
            <div key={tx.id} className={`p-4 rounded-2xl border flex justify-between items-center ${darkMode ? 'bg-gray-900 border-gray-800' : 'bg-white border-slate-200 shadow-sm'}`}>
              <div>
                <h4 className="font-extrabold text-xs">{tx.item}</h4>
                <p className="text-[10px] text-slate-400 mt-0.5">{tx.date} • {tx.time} • {tx.branch}</p>
              </div>
              <span className="font-black text-xs text-emerald-500">Rp {tx.price.toLocaleString('id-ID')}</span>
            </div>
          ))
        )}
      </div>
    </div>
  );
}

// ============================================================================
// 5. MEMBER TAB
// ============================================================================
function MemberTab({ currentUser, members, setMembers, showToast, darkMode }) {
  const isAdmin = currentUser.role === 'admin';
  const [name, setName] = useState('');
  const [phone, setPhone] = useState('');
  const [initialPoints, setInitialPoints] = useState('0');

  const handleAddMember = (e) => {
    e.preventDefault();
    if (!name.trim()) return;
    setMembers([...members, { 
      id: Math.random().toString(), 
      name: name.trim(), 
      phone: phone.trim() || '-', 
      points: parseInt(initialPoints) || 0 
    }]);
    setName('');
    setPhone('');
    setInitialPoints('0');
    showToast('Member baru ditambahkan dengan poin!');
  };

  const handleDeleteMember = (id) => {
    if (confirm('Hapus member ini?')) {
      setMembers(members.filter(m => m.id !== id));
      showToast('Member berhasil dihapus.');
    }
  };

  return (
    <div className="p-4 max-w-md mx-auto space-y-4">
      <div>
        <h2 className="text-lg font-black">Data Member Loyalitas</h2>
        <p className="text-xs text-slate-400">Kelola pelanggan terdaftar</p>
      </div>

      <form onSubmit={handleAddMember} className={`p-4 rounded-2xl border space-y-3 ${darkMode ? 'bg-gray-900 border-gray-800' : 'bg-white border-slate-200 shadow-sm'}`}>
        <h3 className="text-xs font-bold text-blue-500">Tambah Member Baru & Poin</h3>
        <input type="text" placeholder="Nama Member" required value={name} onChange={(e) => setName(e.target.value)} className="w-full px-4 py-2.5 rounded-xl border dark:border-gray-700 bg-slate-50 dark:bg-gray-800 text-xs font-medium" />
        <input type="text" placeholder="Nomor Telepon" value={phone} onChange={(e) => setPhone(e.target.value)} className="w-full px-4 py-2.5 rounded-xl border dark:border-gray-700 bg-slate-50 dark:bg-gray-800 text-xs font-medium" />
        <div>
          <label className="text-[10px] text-slate-400 font-bold mb-1 block">Poin Awal (Opsional)</label>
          <input type="number" value={initialPoints} onChange={(e) => setInitialPoints(e.target.value)} className="w-full px-4 py-2.5 rounded-xl border dark:border-gray-700 bg-slate-50 dark:bg-gray-800 text-xs font-medium" />
        </div>
        <button type="submit" className="w-full py-3 rounded-xl bg-blue-600 text-white font-bold text-xs shadow-md">Tambah Member</button>
      </form>

      <div className="space-y-2">
        {members.map((m) => (
          <div key={m.id} className={`p-3.5 rounded-2xl border flex justify-between items-center ${darkMode ? 'bg-gray-900 border-gray-800' : 'bg-white border-slate-200 shadow-sm'}`}>
            <div>
              <h4 className="font-bold text-xs">{m.name}</h4>
              <p className="text-[10px] text-slate-400">{m.phone}</p>
            </div>
            <div className="flex items-center gap-3">
              <span className="px-3 py-1 rounded-full bg-blue-500/10 text-blue-500 text-xs font-black">{m.points} Poin</span>
              {isAdmin && (
                <button onClick={() => handleDeleteMember(m.id)} className="p-1.5 rounded-lg bg-rose-500/10 text-rose-500">
                  <Trash2 className="w-3.5 h-3.5" />
                </button>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}

