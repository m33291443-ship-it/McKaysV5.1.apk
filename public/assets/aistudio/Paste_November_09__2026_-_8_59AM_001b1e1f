function StockTab({ currentUser, branchInventory, setBranchInventory, stockOrders, setStockOrders, masterPrices, setMasterPrices, setPriceNotification, darkMode, showToast }) {
  const isAdmin = currentUser.role === 'admin';
  const activeBranch = currentUser.branch;
  const rawItems = branchInventory[activeBranch] || [];

  const [searchTerm, setSearchTerm] = useState('');
  const [isOrderModalOpen, setIsOrderModalOpen] = useState(false);
  
  const [orderCart, setOrderCart] = useState([]);
  const [cartItemName, setCartItemName] = useState('');
  const [cartMl, setCartMl] = useState('');
  const [cartSize, setCartSize] = useState('30ml');
  const [cartBotol, setCartBotol] = useState('');

  const [selectedBranchView, setSelectedBranchView] = useState('Bandung');

  // Local draft states for Admin price editing before confirmation
  const [priceDrafts, setPriceDrafts] = useState({});

  useEffect(() => {
    // Initialize price drafts with current master prices
    const initial = {};
    Object.keys(masterPrices).forEach(k => {
      initial[k] = {
        ml: masterPrices[k].price_ml,
        botol: masterPrices[k].price_botol
      };
    });
    setPriceDrafts(initial);
  }, [masterPrices]);

  const filteredItems = rawItems
    .filter(i => i.name.toLowerCase().includes(searchTerm.toLowerCase()))
    .sort((a, b) => a.name.localeCompare(b.name));

  const bottleSizesOrder = ['10ml', '15ml', '20ml', '30ml', '50ml', '100ml'];

  const handleDeleteItem = (id) => {
    if (confirm('Hapus item produk ini dari stok?')) {
      const updated = { ...branchInventory };
      updated[activeBranch] = updated[activeBranch].filter(i => i.id !== id);
      setBranchInventory(updated);
      showToast('Item berhasil dihapus.');
    }
  };

  const handleAdminDeleteBranchItem = (branchName, id) => {
    if (confirm(`Hapus item ini dari stok cabang ${branchName}?`)) {
      const updated = { ...branchInventory };
      updated[branchName] = updated[branchName].filter(i => i.id !== id);
      setBranchInventory(updated);
      showToast(`Item berhasil dihapus dari ${branchName}.`);
    }
  };

  const handleConfirmSinglePrice = (itemName) => {
    const draft = priceDrafts[itemName];
    if (!draft) return;

    const updated = {
      ...masterPrices,
      [itemName]: { price_ml: parseFloat(draft.ml) || 0, price_botol: parseFloat(draft.botol) || 0 }
    };
    setMasterPrices(updated);
    setPriceNotification(`Harga ${itemName} telah diperbarui oleh Admin!`);
    showToast(`Harga ${itemName} berhasil dikonfirmasi & disinkronkan!`);
  };

  const handleConfirmAllPrices = () => {
    const updated = { ...masterPrices };
    Object.keys(priceDrafts).forEach(itemName => {
      const draft = priceDrafts[itemName];
      updated[itemName] = {
        price_ml: parseFloat(draft.ml) || 0,
        price_botol: parseFloat(draft.botol) || 0
      };
    });
    setMasterPrices(updated);
    setPriceNotification(`Semua harga master telah diperbarui oleh Admin!`);
    showToast('Semua harga berhasil dikonfirmasi & disinkronkan ke seluruh cabang!');
  };

  const handleAddToCart = (e) => {
    e.preventDefault();
    if (!cartItemName.trim()) return;

    const newItem = {
      id: Math.random().toString(),
      item: cartItemName.trim(),
      ml: parseFloat(cartMl) || 0,
      bottleSize: cartSize,
      botol: parseFloat(cartBotol) || 0
    };

    setOrderCart([...orderCart, newItem]);
    setCartItemName('');
    setCartMl('');
    setCartBotol('');
    showToast('Item ditambahkan ke keranjang order.');
  };

  const handleRemoveFromCart = (id) => {
    setOrderCart(orderCart.filter(item => item.id !== id));
  };

  const handleSendBatchOrder = () => {
    if (orderCart.length === 0) return;

    const newOrders = orderCart.map(c => ({
      id: `ORD-${Math.floor(100 + Math.random() * 900)}`,
      branch: activeBranch,
      item: c.item,
      ml: c.ml,
      bottleSize: c.bottleSize,
      botol: c.botol,
      status: 'Menunggu Persetujuan'
    }));

    setStockOrders([...stockOrders, ...newOrders]);
    setOrderCart([]);
    setIsOrderModalOpen(false);
    showToast('Semua order di keranjang berhasil dikirim ke Admin Pusat!');
  };

  const exportBranchStockCSV = (branchName) => {
    const items = branchInventory[branchName] || [];
    let content = "No,Nama Produk,Stok Bibit (ml),Stok Botol (pcs)\n";
    items.forEach((item, idx) => {
      content += `${idx + 1},"${item.name}",${item.stock_ml || 0},${item.stock_botol || 0}\n`;
    });
    const blob = new Blob([content], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.setAttribute("href", url);
    link.setAttribute("download", `Stok_Cabang_${branchName}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    showToast(`Export CSV Stok Cabang ${branchName} Berhasil!`);
  };

  const exportBranchStockPDF = (branchName) => {
    window.print();
    showToast(`Mencetak PDF Stok Cabang ${branchName}...`);
  };

  return (
    <div className="p-4 max-w-md mx-auto space-y-5">
      <div className="flex justify-between items-center">
        <div>
          <h2 className="text-lg font-black">{isAdmin ? 'Kelola Stok Cabang' : `Katalog & Stok (${activeBranch})`}</h2>
          <p className="text-xs text-slate-400">Pemisahan Stok Bibit & Botol (A-Z)</p>
        </div>
        {!isAdmin && (
          <button 
            onClick={() => setIsOrderModalOpen(true)}
            className="px-4 py-2.5 rounded-2xl bg-blue-600 text-white font-bold text-xs shadow-lg shadow-blue-600/30 flex items-center gap-1.5"
          >
            <ShoppingCart className="w-4 h-4" /> Keranjang Order ({orderCart.length})
          </button>
        )}
      </div>

      {isAdmin && (
        <div className={`p-4 rounded-3xl border space-y-3 ${darkMode ? 'bg-gray-900 border-gray-800' : 'bg-white border-slate-200 shadow-sm'}`}>
          <div className="flex justify-between items-center">
            <div>
              <h3 className="text-xs font-extrabold text-blue-500 uppercase tracking-wider">Kelola Harga Master (Per ml & Botol)</h3>
              <p className="text-[10px] text-slate-400">Konfirmasi perubahan harga agar tersinkron ke staff.</p>
            </div>
            <button 
              onClick={handleConfirmAllPrices}
              className="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[10px] flex items-center gap-1 shadow-md shadow-emerald-600/20 transition"
              title="Konfirmasi Semua Harga"
            >
              <CheckCheck className="w-3.5 h-3.5" /> Konfirmasi Semua
            </button>
          </div>

          <div className="space-y-3 max-h-56 overflow-y-auto pr-1">
            {Object.keys(masterPrices).map(itemName => (
              <div key={itemName} className="p-3 rounded-2xl border dark:border-gray-800 bg-slate-50 dark:bg-gray-800/40 space-y-2">
                <div className="flex justify-between items-center">
                  <span className="font-extrabold text-xs">{itemName}</span>
                  <button 
                    onClick={() => handleConfirmSinglePrice(itemName)}
                    className="p-1.5 rounded-xl bg-blue-600 text-white text-[10px] font-bold flex items-center gap-1 shadow-sm hover:bg-blue-700 transition"
                    title="Konfirmasi Perubahan Harga Ini"
                  >
                    <Check className="w-3.5 h-3.5" /> Konfirmasi
                  </button>
                </div>
                <div className="grid grid-cols-2 gap-2">
                  <div>
                    <span className="text-[10px] text-slate-400 font-bold block mb-0.5">Harga / ml</span>
                    <input 
                      type="number"
                      value={priceDrafts[itemName]?.ml ?? masterPrices[itemName].price_ml}
                      onChange={(e) => {
                        const val = e.target.value;
                        setPriceDrafts(prev => ({
                          ...prev,
                          [itemName]: { ...prev[itemName], ml: val }
                        }));
                      }}
                      placeholder="Harga / ml"
                      className="w-full px-3 py-2 rounded-xl border dark:border-gray-700 bg-white dark:bg-gray-800 text-xs font-bold"
                    />
                  </div>
                  <div>
                    <span className="text-[10px] text-slate-400 font-bold block mb-0.5">Harga Botol</span>
                    <input 
                      type="number"
                      value={priceDrafts[itemName]?.botol ?? masterPrices[itemName].price_botol}
                      onChange={(e) => {
                        const val = e.target.value;
                        setPriceDrafts(prev => ({
                          ...prev,
                          [itemName]: { ...prev[itemName], botol: val }
                        }));
                      }}
                      placeholder="Harga Botol"
                      className="w-full px-3 py-2 rounded-xl border dark:border-gray-700 bg-white dark:bg-gray-800 text-xs font-bold"
                    />
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {isAdmin && (
        <div className={`p-4 rounded-3xl border space-y-3 ${darkMode ? 'bg-gray-900 border-gray-800' : 'bg-white border-slate-200 shadow-sm'}`}>
          <div className="flex justify-between items-center">
            <h3 className="text-xs font-extrabold text-purple-500 uppercase tracking-wider">Lihat & Hapus Stok Cabang Staff</h3>
            <div className="flex gap-1.5">
              <button onClick={() => exportBranchStockPDF(selectedBranchView)} className="px-2.5 py-1 rounded-lg bg-blue-600 text-white text-[10px] font-bold">PDF</button>
              <button onClick={() => exportBranchStockCSV(selectedBranchView)} className="px-2.5 py-1 rounded-lg bg-emerald-600 text-white text-[10px] font-bold">Excel</button>
            </div>
          </div>
          <select 
            value={selectedBranchView}
            onChange={(e) => setSelectedBranchView(e.target.value)}
            className="w-full px-3 py-2 rounded-xl border dark:border-gray-700 bg-slate-50 dark:bg-gray-800 text-xs font-bold"
          >
            {Object.keys(branchInventory).filter(b => b !== 'Pusat').map(b => (
              <option key={b} value={b}>Cabang {b}</option>
            ))}
          </select>
          <div className="space-y-2 max-h-40 overflow-y-auto">
            {(branchInventory[selectedBranchView] || []).length === 0 ? (
              <p className="text-xs text-slate-400 text-center py-2">Cabang ini kosong stok.</p>
            ) : (
              (branchInventory[selectedBranchView] || []).map(item => (
                <div key={item.id} className="flex justify-between items-center p-2 rounded-xl border dark:border-gray-800 text-xs">
                  <div>
                    <span className="font-bold">{item.name}</span>
                    <span className="text-[10px] text-slate-400 ml-2">({item.stock_ml || 0}ml | {item.stock_botol || 0}pcs)</span>
                  </div>
                  <button onClick={() => handleAdminDeleteBranchItem(selectedBranchView, item.id)} className="p-1 rounded bg-rose-500/10 text-rose-500">
                    <Trash2 className="w-3.5 h-3.5" />
                  </button>
                </div>
              ))
            )}
          </div>
        </div>
      )}

      <div className="relative">
        <Search className="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
        <input 
          type="text"
          placeholder="Cari produk..."
          value={searchTerm}
          onChange={(e) => setSearchTerm(e.target.value)}
          className="w-full pl-10 pr-4 py-3 rounded-2xl border dark:border-gray-700 bg-white dark:bg-gray-900 text-xs font-semibold"
        />
      </div>

      <div className="space-y-6">
        
        {/* Katalog Bibit */}
        <div className="space-y-3">
          <h3 className="text-xs font-black uppercase tracking-wider text-blue-500 flex items-center gap-1.5">
            <Package className="w-4 h-4" /> Katalog Stok Bibit (ml)
          </h3>
          <div className="space-y-3">
            {filteredItems.length === 0 ? (
              <p className="text-center py-6 text-slate-400 text-xs">Belum ada stok bibit.</p>
            ) : (
              filteredItems.map((item) => (
                <div key={`bibit-${item.id}`} className={`p-4 rounded-2xl border flex justify-between items-center ${darkMode ? 'bg-gray-900 border-gray-800' : 'bg-white border-slate-200 shadow-sm'}`}>
                  <div>
                    <h3 className="font-extrabold text-sm">{item.name}</h3>
                    <p className="text-xs font-bold text-blue-500 mt-1">Sisa Stok Bibit: {item.stock_ml || 0} ml</p>
                    <p className="text-[10px] text-slate-400 mt-0.5">Harga: Rp {masterPrices[item.name]?.price_ml || 4000}/ml</p>
                  </div>
                  {isAdmin && (
                    <button onClick={() => handleDeleteItem(item.id)} className="p-2 rounded-xl bg-rose-500/10 text-rose-500">
                      <Trash2 className="w-4 h-4" />
                    </button>
                  )}
                </div>
              ))
            )}
          </div>
        </div>

        {/* Katalog Botol */}
        <div className="space-y-3">
          <h3 className="text-xs font-black uppercase tracking-wider text-purple-500 flex items-center gap-1.5">
            <Box className="w-4 h-4" /> Katalog Stok Botol (Pcs per Ukuran)
          </h3>
          <div className="grid grid-cols-2 gap-3">
            {bottleSizesOrder.map((size) => {
              const totalBotolForSize = filteredItems.reduce((acc, curr) => acc + (curr.stock_botol || 0), 0);
              return (
                <div key={size} className={`p-3.5 rounded-2xl border space-y-1 ${darkMode ? 'bg-gray-900 border-gray-800' : 'bg-white border-slate-200 shadow-sm'}`}>
                  <span className="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Botol Ukuran</span>
                  <h4 className="font-black text-sm text-purple-500">{size}</h4>
                  <p className="text-xs font-bold">Sisa: {Math.round(totalBotolForSize / bottleSizesOrder.length)} pcs</p>
                </div>
              );
            })}
          </div>
        </div>

      </div>

      {/* Cart & Order Modal */}
      {isOrderModalOpen && (
        <div className="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4">
          <div className={`w-full max-w-lg rounded-t-3xl sm:rounded-3xl p-6 space-y-4 max-h-[90vh] overflow-y-auto ${darkMode ? 'bg-gray-900 text-white border border-gray-800' : 'bg-white text-slate-900'}`}>
            <div className="flex justify-between items-center pb-2 border-b dark:border-gray-800">
              <h3 className="font-black text-base">Keranjang & Order Stok ke Admin</h3>
              <button onClick={() => setIsOrderModalOpen(false)} className="p-2 rounded-full bg-slate-100 dark:bg-gray-800">
                <X className="w-4 h-4" />
              </button>
            </div>

            <form onSubmit={handleAddToCart} className="space-y-3 p-4 rounded-2xl border dark:border-gray-800 bg-slate-50 dark:bg-gray-800/50">
              <h4 className="text-xs font-extrabold text-blue-500">Tambah Item ke Keranjang Order</h4>
              <div>
                <label className="text-[10px] font-bold text-slate-400 mb-1 block">Nama Item / Parfum</label>
                <input 
                  type="text"
                  required
                  placeholder="cth: VC Scandal"
                  value={cartItemName}
                  onChange={(e) => setCartItemName(e.target.value)}
                  className="w-full px-3 py-2 rounded-xl border dark:border-gray-700 bg-white dark:bg-gray-800 text-xs font-bold"
                />
              </div>

              <div className="grid grid-cols-3 gap-2">
                <div>
                  <label className="text-[10px] font-bold text-slate-400 mb-1 block">Bibit (ml)</label>
                  <input 
                    type="number"
                    placeholder="0"
                    value={cartMl}
                    onChange={(e) => setCartMl(e.target.value)}
                    className="w-full px-3 py-2 rounded-xl border dark:border-gray-700 bg-white dark:bg-gray-800 text-xs font-bold"
                  />
                </div>
                <div>
                  <label className="text-[10px] font-bold text-slate-400 mb-1 block">Ukuran Botol</label>
                  <select 
                    value={cartSize}
                    onChange={(e) => setCartSize(e.target.value)}
                    className="w-full px-3 py-2 rounded-xl border dark:border-gray-700 bg-white dark:bg-gray-800 text-xs font-bold"
                  >
                    {bottleSizesOrder.map(s => <option key={s} value={s}>{s}</option>)}
                  </select>
                </div>
                <div>
                  <label className="text-[10px] font-bold text-slate-400 mb-1 block">Jumlah Botol</label>
                  <input 
                    type="number"
                    placeholder="0"
                    value={cartBotol}
                    onChange={(e) => setCartBotol(e.target.value)}
                    className="w-full px-3 py-2 rounded-xl border dark:border-gray-700 bg-white dark:bg-gray-800 text-xs font-bold"
                  />
                </div>
              </div>

              <button 
                type="submit"
                className="w-full py-2.5 rounded-xl bg-blue-600 text-white font-bold text-xs shadow-md"
              >
                + Masukkan ke Keranjang
              </button>
            </form>

            <div className="space-y-2">
              <h4 className="text-xs font-bold text-slate-400">Daftar Item di Keranjang ({orderCart.length}):</h4>
              {orderCart.length === 0 ? (
                <p className="text-xs text-slate-400 text-center py-4">Keranjang order masih kosong.</p>
              ) : (
                orderCart.map((c) => (
                  <div key={c.id} className="p-3 rounded-2xl border dark:border-gray-800 flex justify-between items-center text-xs">
                    <div>
                      <p className="font-extrabold">{c.item}</p>
                      <p className="text-[10px] text-slate-400">Bibit: {c.ml}ml | Botol ({c.bottleSize}): {c.botol}pcs</p>
                    </div>
                    <button onClick={() => handleRemoveFromCart(c.id)} className="p-1.5 rounded-lg bg-rose-500/10 text-rose-500">
                      <Trash2 className="w-3.5 h-3.5" />
                    </button>
                  </div>
                ))
              )}
            </div>

            {orderCart.length > 0 && (
              <button 
                onClick={handleSendBatchOrder}
                className="w-full py-3.5 rounded-2xl bg-emerald-600 text-white font-extrabold text-xs shadow-xl shadow-emerald-600/30 flex items-center justify-center gap-2"
              >
                <Send className="w-4 h-4" />
                Kirim Semua Order ke Admin
              </button>
            )}
          </div>
        </div>
      )}
    </div>
  );
}

