            ) : (
              'M'
            )}
          </div>
          <h1 className="text-xl font-black tracking-tight">McKays</h1>
        </div>

        <form onSubmit={handleLogin} className="space-y-4">
          <div>
            <label className="text-xs font-bold text-slate-400 mb-1 block">ID</label>
            <input 
              type="text" 
              required
              placeholder="ID"
              value={username}
              onChange={(e) => setUsername(e.target.value)}
