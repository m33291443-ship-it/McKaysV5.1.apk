function SalesModal({ currentUser, branchInventory, setBranchInventory, transactions, setTransactions, masterPrices, members, setMembers, onClose, showToast, darkMode }) {
  const activeBranch = currentUser.branch;
  const rawItems = branchInventory[activeBranch] || [];

  const [saleType, setSaleType] = useState('Kombinasi (Bibit + Botol)');
  const [itemQuery, setItemQuery] = useState('');
  const [takaranMl, setTakaranMl] = useState('0');
  const [bottleSize, setBottleSize] = useState('30ml');
  const [jumlahBotol, setJumlahBotol] = useState('0');
  const [price, setPrice] = useState('0');
  const [cashPaid, setCashPaid] = useState('0');
  const [member, setMember] = useState('Umum');

  const [isQuickAddMemberOpen, setIsQuickAddMemberOpen] = useState(false);
  const [newMemName, setNewMemName] = useState('');
  const [newMemPhone, setNewMemPhone] = useState('');

  const filteredCatalogSuggestions = rawItems.filter(i => i.name.toLowerCase().includes(itemQuery.toLowerCase()));

  useEffect(() => {
    const ml = parseFloat(takaranMl) || 0;
    const botolPcs = parseFloat(jumlahBotol) || 0;
    const pricing = masterPrices[itemQuery] || masterPrices[rawItems[0]?.name] || { price_ml: 4000, price_botol: 6000 };
    
    let calc = 0;
    if (saleType.includes('Kombinasi')) {
      calc = (pricing.price_ml * ml) + (pricing.price_botol * botolPcs);
    } else if (saleType.includes('Bibit')) {
      calc = pricing.price_ml * ml;
    } else if (saleType.includes('Botol')) {
      calc = pricing.price_botol * botolPcs;
    }
    setPrice(calc > 0 ? calc.toString() : '0');
  }, [itemQuery, takaranMl, jumlahBotol, saleType, masterPrices]);

  const handleKeypadPress = (val) => {
    if (val === 'C') {
      setCashPaid('0');
    } else if (val === 'DEL') {
      setCashPaid(prev => prev.length > 1 ? prev.slice(0, -1) : '0');
    } else {
      setCashPaid(prev => prev === '0' ? val : prev + val);
    }
  };

  const handleQuickAddMember = (e) => {
    e.preventDefault();
    if (!newMemName.trim()) return;
    const newM = {
      id: Math.random().toString(),
      name: newMemName.trim(),
      phone: newMemPhone.trim() || '-',
      points: 10
    };
    setMembers([...members, newM]);
    setMember(newM.name);
    setIsQuickAddMemberOpen(false);
    setNewMemName('');
    setNewMemPhone('');
    showToast('Member baru berhasil ditambahkan!');
  };

  const handleSubmit = (e) => {
    if (e) e.preventDefault();
    const mlVal = parseFloat(takaranMl) || 0;
    const botolVal = parseFloat(jumlahBotol) || 0;
    const priceVal = parseFloat(price) || 0;

    const matchedItem = rawItems.find(i => i.name.toLowerCase() === itemQuery.toLowerCase()) || rawItems[0];

    if (matchedItem) {
      if (matchedItem.stock_ml < mlVal) {
        alert('Stok bibit tidak mencukupi!');
        return;
      }
      if (matchedItem.stock_botol < botolVal) {
        alert('Stok botol tidak mencukupi!');
        return;
      }

      const updated = { ...branchInventory };
      updated[activeBranch] = updated[activeBranch].map(item => {
        if (item.id === matchedItem.id) {
          return {
            ...item,
            stock_ml: item.stock_ml - mlVal,
            stock_botol: item.stock_botol - botolVal
          };
        }
        return item;
      });
      setBranchInventory(updated);
    }

    const newTx = {
      id: `TRX-${Math.floor(1000 + Math.random() * 9000)}`,
      branch: activeBranch,
      type: saleType,
      item: itemQuery ? `${itemQuery} (${takaranMl}ml)` : 'Penjualan',
      detail: `${saleType} | ${takaranMl}ml | ${jumlahBotol}pcs`,
      price: priceVal,
      member: member,
      pointsEarned: Math.floor(priceVal / 10000),
      time: new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }),
      date: new Date().toISOString().split('T')[0]
    };

    setTransactions([newTx, ...transactions]);
    showToast('Transaksi berhasil disimpan!');
    onClose();
  };

  const numericPrice = parseFloat(price) || 0;

