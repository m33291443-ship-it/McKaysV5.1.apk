            ))}
          </div>

          <button 
            type="button"
            onClick={handleSubmit}
            className="w-full py-4 rounded-2xl bg-blue-600 hover:bg-blue-700 text-white font-extrabold text-sm shadow-xl shadow-blue-600/30 transition mt-2"
          >
            Proses & Selesaikan Transaksi
          </button>
        </div>

      </div>
    </div>
  );
}
